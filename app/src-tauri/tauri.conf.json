{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlopTweak",
  "version": "0.2.0",
  "identifier": "com.sloptweak.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "SlopTweak",
        "width": 920,
        "height": 700,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "The SlopTweak contributors",
    "copyright": "Copyright (c) The SlopTweak contributors. MIT License.",
    "homepage": "https://github.com/ljohnsoncpu/SlopTweak",
    "shortDescription": "Run InvokeAI on a rented Vast.ai GPU",
    "longDescription": "SlopTweak rents a GPU on your own Vast.ai account, starts InvokeAI on it, shows it in a window, saves your images to your PC, and shuts the GPU down when you're done."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2RjU5MTlFNzFGODgyRkIKUldUN2d2aHhucEgxTnIydzJ1UkZZcDE0RkJyZEd4emVoNjNPazlRdXFtNFFYYjhITlRSZDVpRmEK",
      "endpoints": [
        "https://github.com/ljohnsoncpu/SlopTweak/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
