{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local launcher UI only. The remote Invoke window gets no capability.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-snapshot",
    "allow-refresh-catalog",
    "allow-estimate",
    "allow-start-session",
    "allow-stop-session",
    "allow-open-invoke",
    "allow-dismiss",
    "allow-set-secret",
    "allow-check-credit",
    "allow-save-settings",
    "allow-select-model",
    "allow-pick-output-folder",
    "allow-reset-output-folder",
    "allow-add-lora",
    "allow-remove-lora",
    "allow-set-lora-enabled",
    "allow-open-link",
    "allow-scan-orphans",
    "allow-destroy-orphan",
    "allow-reattach-orphan",
    "allow-confirm-close"
  ]
}
